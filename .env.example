APP_NAME=SaucePls
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- SaucePls Auth ---

# Brevo (Transactional Email API) - used to send email OTP codes.
# Get your API key from https://app.brevo.com/settings/keys/api
BREVO_API_KEY=
BREVO_FROM_ADDRESS="noreply@saucepls.app"
BREVO_FROM_NAME="SaucePls"

# Google OAuth - used for "Sign in with Google".
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must be: {APP_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# SauceNAO - reverse image search used to check if an uploaded image is
# easily identifiable. Get an API key from https://saucenao.com/user.php
SAUCENAO_API_KEY=
SAUCENAO_MIN_SIMILARITY=60

# OCR.space - cloud OCR used to extract text from an uploaded image and
# pre-fill the request's text field. Get a free API key from
# https://ocr.space/ocrapi/freekey
OCR_SPACE_API_KEY=
# OCR_SPACE_ENDPOINT=https://api.ocr.space/parse/image
# OCR_SPACE_LANGUAGE=auto
# OCR_SPACE_ENGINE=2

# Tag inference - DeepDanbooru-style model inference used to auto-suggest
# tags for an uploaded image and pre-fill the request's tags field.
# TAG_INFERENCE_ENDPOINT=https://deepdanbooru.nsk.sh/deepdanbooru
# TAG_INFERENCE_THRESHOLD=0.5
# TAG_INFERENCE_MAX_TAGS=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

DRAFTS_TTL_HOURS=1